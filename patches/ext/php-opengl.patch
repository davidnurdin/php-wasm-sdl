+/* glUniform{1,2,3,4}fv(int location, float[] values): count = number of values / size */
+#define JUMPHP_UNIFORM_FV(fn, glfn, size) \
+PHP_FUNCTION(fn) { \
+    zend_long loc; zval *z_values; GLfloat *values; uint32_t n; \
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "la", &loc, &z_values) == FAILURE) { RETURN_THROWS(); } \
+    n = zend_hash_num_elements(Z_ARRVAL_P(z_values)); \
+    if (n < size) { RETURN_FALSE; } \
+    values = php_array_to_float_array(z_values); \
+    glfn((GLint) loc, (GLsizei) (n / size), values); \
+    efree(values); \
+    RETURN_TRUE; \
+}

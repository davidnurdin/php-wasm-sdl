+/* glBufferSubData(int target, int offset bytes, string|float[] data): a binary string (pack('g*', ...)) or floats */
+PHP_FUNCTION(glBufferSubData) {
+    zend_long target, offset;
+    zval *z_data;
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "llz", &target, &offset, &z_data) == FAILURE) { RETURN_THROWS(); }
+    if (Z_TYPE_P(z_data) == IS_STRING) {
+        glBufferSubData((GLenum) target, (GLintptr) offset, (GLsizeiptr) Z_STRLEN_P(z_data), Z_STRVAL_P(z_data));
+    } else if (Z_TYPE_P(z_data) == IS_ARRAY) {
+        uint32_t n = zend_hash_num_elements(Z_ARRVAL_P(z_data));
+        GLfloat *values;
+        if (n == 0) { return; }
+        values = php_array_to_float_array(z_data);
+        glBufferSubData((GLenum) target, (GLintptr) offset, (GLsizeiptr) (n * sizeof(GLfloat)), values);
+        efree(values);
+    }
+}

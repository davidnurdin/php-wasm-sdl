+/* how many values a glGet* returns */
+static int jumphp_get_count(GLenum pname) {
+    switch (pname) {
+        case GL_VIEWPORT: case GL_SCISSOR_BOX: case GL_COLOR_CLEAR_VALUE: case GL_COLOR_WRITEMASK:
+        case GL_BLEND_COLOR:
+            return 4;
+        case GL_DEPTH_RANGE: case GL_ALIASED_LINE_WIDTH_RANGE: case GL_ALIASED_POINT_SIZE_RANGE:
+        case GL_MAX_VIEWPORT_DIMS:
+            return 2;
+        default:
+            return 1;
+    }
+}
+
+/* int|int[] glGetIntegerv(int pname): the value (or the values: viewport, scissor box...) */
+PHP_FUNCTION(glGetIntegerv) {
+    zend_long pname;
+    GLint values[16] = {0};
+    int i, n;
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "l", &pname) == FAILURE) { RETURN_THROWS(); }
+    glGetIntegerv((GLenum) pname, values);
+    n = jumphp_get_count((GLenum) pname);
+    if (n == 1) { RETURN_LONG((zend_long) values[0]); }
+    array_init(return_value);
+    for (i = 0; i < n; i++) { add_next_index_long(return_value, (zend_long) values[i]); }
+}
+
+/* float|float[] glGetFloatv(int pname) */
+PHP_FUNCTION(glGetFloatv) {
+    zend_long pname;
+    GLfloat values[16] = {0};
+    int i, n;
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "l", &pname) == FAILURE) { RETURN_THROWS(); }
+    glGetFloatv((GLenum) pname, values);
+    n = jumphp_get_count((GLenum) pname);
+    if (n == 1) { RETURN_DOUBLE((double) values[0]); }
+    array_init(return_value);
+    for (i = 0; i < n; i++) { add_next_index_double(return_value, (double) values[i]); }
+}

+/* constants used by the additions that the original does not register */
+static void jumphp_register_constants(int module_number) {
+#define JC(name) REGISTER_LONG_CONSTANT(#name, name, CONST_CS | CONST_PERSISTENT)
+    JC(GL_FRAMEBUFFER); JC(GL_RENDERBUFFER); JC(GL_COLOR_ATTACHMENT0); JC(GL_DEPTH_ATTACHMENT);

+/*
+ * JumPHP additions to PHP-OpenGL (included by php_opengl.c): what a game engine needs on top of the
+ * original functions, all of them in OpenGL ES 2 / WebGL 1 so that the same PHP code runs on the desktop
+ * and in the browser (emscripten): framebuffers, state queries, the other uniform setters, partial buffer
+ * updates, pixels as binary strings, shader / program status without fatal errors.
+ */
+
+#define JUMPHP_GEN(fn, glfn) \
+PHP_FUNCTION(fn) { \
+    zend_long n; zval *z_out; GLuint *ids; \
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "lz/", &n, &z_out) == FAILURE) { RETURN_THROWS(); } \
+    if (n <= 0) { RETURN_FALSE; } \
+    ids = (GLuint*) emalloc(sizeof(GLuint) * n); \
+    glfn((GLsizei) n, ids); \
+    convert_gluint_array_to_zval(ids, n, z_out); \
+    efree(ids); \
+    RETURN_TRUE; \
+}
+
+#define JUMPHP_DELETE(fn, glfn) \
+PHP_FUNCTION(fn) { \
+    zend_long n; zval *z_ids; GLuint *ids; \
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "la", &n, &z_ids) == FAILURE) { RETURN_THROWS(); } \
+    if (n <= 0 || zend_hash_num_elements(Z_ARRVAL_P(z_ids)) < (uint32_t) n) { RETURN_FALSE; } \
+    ids = php_array_to_uint_array(z_ids); \
+    glfn((GLsizei) n, ids); \
+    efree(ids); \
+    RETURN_TRUE; \
+}
+

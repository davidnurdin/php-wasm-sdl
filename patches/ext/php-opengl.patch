+/* pixels given to glTexImage2D / glTexSubImage2D: null (allocate only), a binary string, or the original int array */
+static GLvoid *jumphp_pixels(zval *pixels, zend_bool *allocated) {
+    *allocated = 0;
+    if (pixels == NULL || Z_TYPE_P(pixels) == IS_NULL) {
+        return NULL;
+    }
+    if (Z_TYPE_P(pixels) == IS_STRING) {
+        return Z_STRVAL_P(pixels);
+    }
+    convert_to_array(pixels);
+    *allocated = 1;
+    return php_array_to_int_array(pixels);
+}

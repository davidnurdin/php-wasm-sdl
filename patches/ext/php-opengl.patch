+/* string glReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE): the pixels, bottom row first */
+PHP_FUNCTION(glReadPixels) {
+    zend_long x, y, w, h, format, type;
+    zend_string *out;
+    if (zend_parse_parameters(ZEND_NUM_ARGS(), "llllll", &x, &y, &w, &h, &format, &type) == FAILURE) { RETURN_THROWS(); }
+    if (w <= 0 || h <= 0 || format != GL_RGBA || type != GL_UNSIGNED_BYTE) {
+        php_error_docref(NULL, E_WARNING, "glReadPixels: only GL_RGBA / GL_UNSIGNED_BYTE, positive sizes");
+        RETURN_FALSE;
+    }
+    out = zend_string_alloc((size_t) (w * h * 4), 0);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels((GLint) x, (GLint) y, (GLsizei) w, (GLsizei) h, GL_RGBA, GL_UNSIGNED_BYTE, ZSTR_VAL(out));
+    ZSTR_VAL(out)[w * h * 4] = '\0';
+    RETURN_NEW_STR(out);
+}
